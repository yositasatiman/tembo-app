// TEMBO — ขั้นที่ 1: ผู้ใช้, การยืนยันตัวตน, กระเป๋า Coin และบัญชีแยกประเภท (ledger)
// ขั้นที่ 2–3: แบบสอบถาม + Escrow, ขั้นที่ 4: Event

generator client {
  provider        = "prisma-client-js"
  // ใช้ query compiler (ไม่มี Rust engine) + driver adapter ของ node-postgres
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  MEMBER
  ADMIN
}

enum OtpPurpose {
  LOGIN
  VERIFY_CMU
}

enum WalletKind {
  USER
  SYSTEM_MINT
  SYSTEM_BURN
  ESCROW
}

enum TxType {
  SIGNUP_BONUS
  ADMIN_ADJUST
  POST_FEE
  ESCROW_FUND
  SUBSIDY
  SURVEY_REWARD
  ESCROW_REFUND
  EVENT_REWARD
}

enum SurveyStatus {
  /// รอแอดมินตรวจ (ขอระบบสมทบ) — ยังรับคำตอบไม่ได้ แต่รับ Coin สนับสนุนได้
  PENDING_REVIEW
  OPEN
  CLOSED
}

enum SurveyMode {
  /// สร้างคำถามใน TEMBO
  IN_APP
  /// ใช้ลิงก์แบบสอบถามภายนอก (เช่น Google Form) + รหัสยืนยันการตอบ
  EXTERNAL
}

enum SubsidyStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  /// รอแอดมินตรวจ — ยังไม่ขึ้นฟีด ค่าโพสต์ยังพักอยู่ใน Escrow
  PENDING_REVIEW
  PUBLISHED
  /// แอดมินไม่อนุมัติ — คืน Coin ทั้งหมด (รวมค่าโพสต์)
  REJECTED
  /// ผู้จัดยกเลิก
  CANCELLED
  /// จบงานและพ้นช่วงเช็กอินแล้ว — คืน Coin รางวัลที่เหลือ
  ENDED
}

enum EventCategory {
  UNIVERSITY
  FACULTY
  CLUB
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  SHORT_TEXT
  LONG_TEXT
  SCALE
}

enum ContributionKind {
  OWNER
  SPONSOR
  SUBSIDY
}

model User {
  id            String     @id @default(cuid())
  /// อีเมลที่ใช้ล็อกอิน (อีเมลอะไรก็ได้) — เก็บเป็นตัวพิมพ์เล็ก
  email         String     @unique
  /// อีเมล @cmu.ac.th ที่ยืนยันแล้ว — 1 อีเมลต่อ 1 บัญชี
  cmuEmail      String?    @unique
  cmuVerifiedAt DateTime?
  displayName   String?
  faculty       String?
  studyYear     Int?
  interests     String[]   @default([])
  role          SystemRole @default(MEMBER)
  /// โค้ดชวนเพื่อน 6 หลัก
  referralCode  String     @unique
  referredById  String?
  referredBy    User?      @relation("Referral", fields: [referredById], references: [id])
  referrals     User[]     @relation("Referral")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallet        Wallet?
  sessions      Session[]
  surveys       Survey[]
  contributions SurveyContribution[]
  responses     SurveyResponse[]
  events        Event[]
  registrations EventRegistration[]
  eventHides    EventHide[]
  surveyStarts  SurveyStart[]
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  /// HMAC-SHA256 ของรหัส (ไม่เก็บรหัสจริง)
  codeHash   String
  /// ผูกกับผู้ใช้เมื่อเป็นการยืนยันอีเมล CMU
  userId     String?
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose, createdAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 ของ refresh token (ไม่เก็บ token จริง)
  refreshTokenHash String    @unique
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Wallet {
  id        String        @id @default(cuid())
  kind      WalletKind
  userId    String?       @unique
  user      User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// ยอดคงเหลือ (cache ของผลรวม LedgerEntry.delta) — อัปเดตในธุรกรรมเดียวกับ entry เสมอ
  balance   Int           @default(0)
  createdAt DateTime      @default(now())
  entries   LedgerEntry[]
  survey    Survey?
  event     Event?
}

/// ธุรกรรม 1 รายการ = ชุดของ entry ที่ผลรวม delta เป็น 0 (double-entry)
model LedgerTx {
  id             String        @id @default(cuid())
  type           TxType
  /// กันการประมวลผลซ้ำ (กดซ้ำ / เน็ตส่งซ้ำ)
  idempotencyKey String        @unique
  memo           String?
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]
}

model LedgerEntry {
  id        String   @id @default(cuid())
  txId      String
  tx        LedgerTx @relation(fields: [txId], references: [id], onDelete: Restrict)
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  delta     Int
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

/// แบบสอบถามงานวิจัย (ขั้นที่ 2: ส่วนเศรษฐกิจ Coin — คำถาม/คำตอบจริงเพิ่มในขั้นที่ 3)
model Survey {
  id                String        @id @default(cuid())
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title             String
  description       String?
  mode              SurveyMode    @default(IN_APP)
  /// ลิงก์แบบสอบถามภายนอก (mode = EXTERNAL)
  externalUrl       String?
  /// รหัสที่ผู้โพสต์ใส่ไว้ในหน้ายืนยันของฟอร์มภายนอก — ผู้ตอบกรอกรหัสนี้ใน TEMBO เพื่อรับ Coin
  completionCode    String?
  questionCount     Int
  rewardPerResponse Int
  quota             Int
  /// ยอดรางวัลรวมที่ต้องหาให้ครบ = rewardPerResponse × quota
  targetPool        Int
  /// ค่าโพสต์ที่จ่ายไปแล้ว (0 = โพสต์แรกฟรี) — ไม่คืน
  postFee           Int
  status            SurveyStatus
  subsidyStatus     SubsidyStatus @default(NONE)
  /// ยอดที่ระบบจะสมทบ/สมทบแล้ว
  subsidyAmount     Int           @default(0)
  subsidyNote       String?
  /// กระเป๋า Escrow ของแบบสอบถามนี้ (ถือ Coin รางวัลที่ยังไม่จ่าย)
  escrowWalletId    String        @unique
  escrowWallet      Wallet        @relation(fields: [escrowWalletId], references: [id], onDelete: Restrict)
  responsesCount    Int           @default(0)
  closesAt          DateTime
  closedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  contributions SurveyContribution[]
  responses     SurveyResponse[]
  questions     SurveyQuestion[]
  starts        SurveyStart[]

  @@index([status, createdAt])
  @@index([ownerId])
  @@index([subsidyStatus])
}

/// ใครลง Coin ใน Escrow เท่าไร — ใช้คืน Coin ที่เหลือตามสัดส่วน
model SurveyContribution {
  id        String           @id @default(cuid())
  surveyId  String
  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  kind      ContributionKind
  /// null = ระบบ (SUBSIDY)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// userId หรือ "SYSTEM" — 1 แถวต่อผู้ลง 1 ราย
  key       String
  amount    Int
  refunded  Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([surveyId, key])
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reward    Int
  /// คำตอบ { [questionId]: number | number[] | string } — ตรวจรูปแบบด้วย validateAnswers (@tembo/shared)
  answers   Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([surveyId, userId])
  @@index([userId])
}

/// ผู้ใช้กดเปิดแบบสอบถามภายนอกเมื่อไร (กันกรอกรหัสทันทีโดยไม่ได้ทำ) และนับครั้งที่กรอกรหัสผิด
model SurveyStart {
  surveyId       String
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime @default(now())
  failedAttempts Int      @default(0)

  @@id([surveyId, userId])
  @@index([userId])
}

model SurveyQuestion {
  id       String       @id @default(cuid())
  surveyId String
  survey   Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  order    Int
  type     QuestionType
  title    String
  required Boolean      @default(true)
  /// ตัวเลือกของคำถามแบบเลือกตอบ
  options  String[]     @default([])
  /// คะแนนสูงสุดของคำถามแบบมาตรวัด (1..scaleMax)
  scaleMax Int?
  minLabel String?
  maxLabel String?

  @@unique([surveyId, order])
}

/// Event ในมหาวิทยาลัย (ขั้นที่ 4) — ต้องให้แอดมินอนุมัติก่อนขึ้นฟีด
model Event {
  id               String        @id @default(cuid())
  organizerId      String
  organizer        User          @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  title            String
  description      String
  /// ชื่อผู้จัดที่แสดง (ชมรม/คณะ/หน่วยงาน)
  hostName         String
  category         EventCategory
  /// แท็กจากรายการความสนใจ (INTERESTS) — ใช้จับคู่ฟีด
  tags             String[]      @default([])
  coverUrl         String?
  location         String
  startsAt         DateTime
  endsAt           DateTime
  /// null = ไม่จำกัดจำนวน
  capacity         Int?
  /// ลิงก์ฟอร์มของผู้จัด (เช่น Google Form) — ถ้ามี ผู้ใช้ต้องกรอกฟอร์มนี้ต่อหลังลงทะเบียนใน TEMBO
  registrationUrl  String?
  /// Coin ต่อคนที่เช็กอิน (0 = ไม่มีรางวัล) — จ่ายจาก Escrow ที่ผู้จัดลงไว้
  rewardPerCheckIn Int           @default(0)
  /// จำนวนคนที่ได้รางวัลสูงสุด
  rewardSlots      Int           @default(0)
  postFee          Int
  status           EventStatus
  reviewNote       String?
  reviewedAt       DateTime?
  escrowWalletId   String        @unique
  escrowWallet     Wallet        @relation(fields: [escrowWalletId], references: [id], onDelete: Restrict)
  /// ใช้สร้างรหัสเช็กอินที่เปลี่ยนทุกนาที (HMAC) — ไม่ส่งออกนอกเซิร์ฟเวอร์
  checkInSecret    String
  registeredCount  Int           @default(0)
  checkedInCount   Int           @default(0)
  rewardedCount    Int           @default(0)
  cancelledAt      DateTime?
  endedAt          DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  registrations EventRegistration[]
  hides         EventHide[]

  @@index([status, startsAt])
  @@index([organizerId])
}

model EventRegistration {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      RegistrationStatus
  checkedInAt DateTime?
  reward      Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([userId])
}

/// "ไม่สนใจ" — ซ่อน Event นี้จากฟีดของผู้ใช้
model EventHide {
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([eventId, userId])
  @@index([userId])
}
