# ---- Database (docker compose up -d) ----
DATABASE_URL="postgresql://tembo:tembo@localhost:5432/tembo"

# ---- API ----
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
# สุ่มค่ายาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
OTP_SECRET="change-me-to-another-long-random-string"
# ส่งอีเมลจริง (ไม่ใส่ทั้งสองแบบ = พิมพ์ OTP ใน console ของ API)
# แบบที่ 1: Resend (ต้องมีโดเมน)
RESEND_API_KEY=""
# แบบที่ 2: Gmail — SMTP_USER = อีเมล Gmail, SMTP_PASS = App Password 16 ตัว
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TEMBO <onboarding@resend.dev>"
COOKIE_SECURE=false
# อยู่หลัง proxy (เซิร์ฟเวอร์จริง) ให้ตั้ง true
TRUST_PROXY=false
# อีเมลที่ได้สิทธิ์แอดมินอัตโนมัติเมื่อล็อกอิน คั่นด้วย ,
ADMIN_EMAILS=""

# ---- Web ----
API_URL="http://localhost:4000"
